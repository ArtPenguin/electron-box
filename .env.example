# 复制本文件为 .env，并填入你真实的 DeepSeek API Key
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---- 可选的联网搜索提供方（Agent 的 webSearch 工具使用）----
# 优先级：Tavily -> 博查 -> 360搜索（免 Key）-> Bing（免 Key）
# 配置了密钥就优先用专业搜索 API；都不配置时自动使用免费源，开箱即用。
# 某个源报错或没有结果时会自动降级到下一个。
# Tavily（推荐，面向 LLM 的搜索 API）：https://app.tavily.com 申请
TAVILY_API_KEY=
# 博查（国内直连，中文搜索友好）：https://open.bochaai.com 申请
BOCHA_API_KEY=
