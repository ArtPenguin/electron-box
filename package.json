{
  "name": "elect",
  "productName": "Elect",
  "version": "1.0.0",
  "description": "Electron 桌面工具箱：LangChain Agent 聊天助手（DeepSeek + 联网搜索）与游戏时长控制（Vue 3 + Pinia + ECharts）",
  "main": "dist/main.js",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && vue-tsc -p renderer/tsconfig.json --noEmit",
    "build:renderer": "vite build && node scripts/build-inline.mjs",
    "build:main": "node scripts/build-main.mjs",
    "build": "npm run build:renderer && npm run build:main",
    "start": "npm run build && electron .",
    "dev": "node scripts/dev.mjs",
    "package": "npm run typecheck && npm run build && electron-forge package",
    "make": "npm run typecheck && npm run build && electron-forge make"
  },
  "keywords": [
    "electron",
    "langchain",
    "agent"
  ],
  "author": "Elect <dev@example.com>",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@types/node": "^22.20.4",
    "@vitejs/plugin-vue": "^6.0.9",
    "electron": "^44.1.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vue-tsc": "^3.3.11"
  },
  "dependencies": {
    "@langchain/core": "^1.2.9",
    "@langchain/langgraph": "^1.4.13",
    "@langchain/openai": "^1.5.11",
    "dotenv": "^17.4.2",
    "echarts": "^6.1.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  }
}
